# Copy to .env for local development. .env is git-ignored.
# Placeholder values only. Never commit real credentials.
DATABASE_URL=postgresql+asyncpg://app:local-only-password@localhost:5432/app
REDIS_URL=redis://:local-only-password@localhost:6379/0
APP_ENV=local
LOG_LEVEL=INFO

# --- Datadog (APM + log correlation) ---
# Tracing is OFF locally and in tests; no Datadog agent is required. Set
# DD_TRACE_ENABLED=true (and DD_AGENT_HOST) only where an agent is reachable.
# The cluster supplies these via the Kubernetes manifests; ddtrace reads DD_*
# directly. Never put a real Datadog API key here.
DD_SERVICE=k8s-fastapi-starter
DD_ENV=local
DD_VERSION=0.1.0
DD_TRACE_ENABLED=false
DD_LOGS_INJECTION=true
# DD_AGENT_HOST=localhost              # trace agent host (node IP in cluster)
# DD_TRACE_AGENT_PORT=8126
# DD_RUNTIME_METRICS_ENABLED=false     # optional
# DD_PROFILING_ENABLED=false           # optional
